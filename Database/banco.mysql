-- ==========================================
-- ORGANIZAE - BANCO DE DADOS
-- ==========================================

CREATE DATABASE IF NOT EXISTS organizador
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE organizador;

-- ==========================================
-- TABELA: ALUNOS
-- ==========================================

CREATE TABLE IF NOT EXISTS alunos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    senha_hash VARCHAR(255) NOT NULL,
    data_cadastro DATETIME NOT NULL,
    senha VARCHAR(255) NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'Ativo'
) ENGINE=InnoDB;

-- ==========================================
-- TABELA: DISCIPLINAS
-- ==========================================

CREATE TABLE IF NOT EXISTS disciplinas (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    descricao TEXT,
    aluno_id INT NOT NULL,

    CONSTRAINT fk_disciplinas_alunos
        FOREIGN KEY (aluno_id)
        REFERENCES alunos(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE
) ENGINE=InnoDB;

-- ==========================================
-- TABELA: TAREFAS
-- ==========================================

CREATE TABLE IF NOT EXISTS tarefas (
    id INT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(150) NOT NULL,
    descricao TEXT,
    tipo VARCHAR(50) NOT NULL,
    data_cadastro DATETIME NOT NULL,
    data_entrega DATE NOT NULL,
    status VARCHAR(30) NOT NULL DEFAULT 'Pendente',
    disciplina_id INT NOT NULL,

    CONSTRAINT fk_tarefas_disciplinas
        FOREIGN KEY (disciplina_id)
        REFERENCES disciplinas(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE
) ENGINE=InnoDB;

ALTER TABLE alunos
ADD COLUMN senha_hash VARCHAR(255) NOT NULL DEFAULT '',
ADD COLUMN data_cadastro DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
ADD COLUMN status VARCHAR (20) NOT NULL DEFAULT 'Ativo',
MODIFY COLUMN email VARCHAR (150) NOT NULL;

ALTER TABLE alunos DROP COLUMN senha;

ALTER TABLE tarefas
ADD COLUMN aluno_id INT NOT NULL AFTER status,
ADD CONSTRAINT fk_tarefas_alunos
FOREIGN KEY (aluno_id) REFERENCES alunos(id)
ON DELETE CASCADE;

SHOW TABLES;

DESCRIBE alunos;
DESCRIBE disciplinas;
DESCRIBE tarefas;

SELECT * FROM alunos;
SELECT * FROM disciplinas;
SELECT * FROM tarefas;